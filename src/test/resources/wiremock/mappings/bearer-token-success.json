{
  "request": {
    "method": "GET",
    "url": "/bearer",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"authenticated\": true,\n  \"token\": \"valid\"\n}"
  }
}
