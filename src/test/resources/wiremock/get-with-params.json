{
  "request": {
    "method": "GET",
    "urlPath": "/get",
    "queryParameters": {
      "param1": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"args\": {\n    \"param1\": \"{{request.query.param1}}\"\n  },\n  \"url\": \"{{request.requestLine.baseUrl}}/get?param1={{request.query.param1}}\"\n}"
  }
}
